{
  "manifest_version": 3,
  "name": "DevPulse - Ponto Senior X",
  "version": "0.1.0",
  "description": "Copia suas marcações de ponto do Senior X para ~/.devpulse/ponto, para o DevPulse sugerir lançamentos de horas.",
  "key": "",
  "permissions": ["alarms", "cookies", "nativeMessaging", "notifications", "storage", "webRequest"],
  "host_permissions": ["https://platform.senior.com.br/*", "https://senior.com.br/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "DevPulse - Ponto (clique para sincronizar)" },
  "icons": { "128": "icon.png" }
}
